# Normalise text files to LF in the repository
* text=auto eol=lf

# Windows-only formats keep CRLF
*.sln  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Drawing and binary files: never convert line endings
*.dxf  -text
*.dwg  binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.xlsx binary
